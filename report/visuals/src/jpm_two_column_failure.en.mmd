%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial", "primaryTextColor": "#222222", "lineColor": "#777777"}}}%%
flowchart LR
  A[JPMorgan two-column page<br/>one sentence in each column] --> B[Text extractor reads<br/>horizontal page positions]
  B --> C[One text line wrongly mixes<br/>left fragment + right fragment]
  C --> D1[DeepSeek / Gemma<br/>reconstruct a single-column sentence]
  C --> D2[Finance pipeline<br/>copies text by evidence number]
  D1 --> E1[Readable sentence<br/>but no longer an exact text match]
  D2 --> E2[Exact text match<br/>but the quote may mix both columns]
  E1 --> F1[String match: fail]
  E2 --> F2[String match: pass]

  classDef source fill:#EEF0F5,stroke:#777777,color:#222222;
  classDef general fill:#E9EEFA,stroke:#2E5A9E,color:#222222;
  classDef finance fill:#E8F3EB,stroke:#3E8E5A,color:#222222;
  classDef fail fill:#F8E8E8,stroke:#B03A3A,color:#222222;
  classDef pass fill:#E8F3EB,stroke:#3E8E5A,color:#222222;
  class A,B,C source;
  class D1,E1 general;
  class D2,E2 finance;
  class F1 fail;
  class F2 pass;
