%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial", "primaryTextColor": "#222222", "lineColor": "#777777"}}}%%
flowchart LR
  A[JPMorgan two-column PDF<br/>left sentence + right sentence] --> B[pdftotext -layout]
  B --> C[One extracted line contains<br/>left fragment + right fragment]
  C --> D1[DeepSeek / Gemma<br/>reconstruct a single-column sentence]
  C --> D2[Finance Evidence ID<br/>copies frozen extracted text]
  D1 --> E1[Reads normally on the page<br/>but is not a contiguous extracted substring]
  D2 --> E2[Exact extracted-text match<br/>but the quote may be interleaved]
  E1 --> F1[Automatic quote check: fail]
  E2 --> F2[Automatic quote check: pass]

  classDef source fill:#EEF0F5,stroke:#777777,color:#222222;
  classDef general fill:#E9EEFA,stroke:#2E5A9E,color:#222222;
  classDef finance fill:#E8F3EB,stroke:#3E8E5A,color:#222222;
  classDef fail fill:#F8E8E8,stroke:#B03A3A,color:#222222;
  classDef pass fill:#E8F3EB,stroke:#3E8E5A,color:#222222;
  class A,B,C source;
  class D1,E1 general;
  class D2,E2 finance;
  class F1 fail;
  class F2 pass;
