%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial Unicode MS", "primaryTextColor": "#222222", "lineColor": "#777777"}}}%%
flowchart LR
  A[JPMorgan双栏PDF页面<br/>左右两栏各有一句话] --> B[文本抽取器<br/>按页面横向位置读取]
  B --> C[同一文本行误混入<br/>左栏片段 + 右栏片段]
  C --> D1[DeepSeek / Gemma<br/>重建单栏连续句子]
  C --> D2[Finance pipeline<br/>按证据编号复制抽取文本]
  D1 --> E1[读起来正常<br/>却不再逐字等于抽取文本]
  D2 --> E2[逐字等于抽取文本<br/>内容却可能左右栏交错]
  E1 --> F1[字符串匹配：失败]
  E2 --> F2[字符串匹配：通过]

  classDef source fill:#EEF0F5,stroke:#777777,color:#222222;
  classDef general fill:#E9EEFA,stroke:#2E5A9E,color:#222222;
  classDef finance fill:#E8F3EB,stroke:#3E8E5A,color:#222222;
  classDef fail fill:#F8E8E8,stroke:#B03A3A,color:#222222;
  classDef pass fill:#E8F3EB,stroke:#3E8E5A,color:#222222;
  class A,B,C source;
  class D1,E1 general;
  class D2,E2 finance;
  class F1 fail;
  class F2 pass;
