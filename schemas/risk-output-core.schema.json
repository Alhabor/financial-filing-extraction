{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk-output-core-v001",
  "title": "Core financial filing risk extraction output",
  "type": "object",
  "required": ["case_id", "model_id", "prompt_version", "risks"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "pattern": "^PV[0-9]{3,}$" },
    "risks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "risk_id", "risk_summary", "risk_type", "evidence_quote", "source_paragraph_ids",
          "source_pages", "reasoning", "financial_impact", "time_horizon",
          "monitoring_indicators", "mitigation", "uncertainty"
        ],
        "properties": {
          "risk_id": { "type": "string", "pattern": "^R[1-3]$" },
          "risk_summary": { "type": "string", "minLength": 4, "maxLength": 180 },
          "risk_type": {
            "type": "string",
            "enum": [
              "Strategic / Market / Technology",
              "Operational / Supply Chain",
              "Regulatory / Legal / Geopolitical",
              "Financial / Liquidity / Credit",
              "Cybersecurity / Data / Privacy",
              "Other"
            ]
          },
          "evidence_quote": { "type": "string", "minLength": 1 },
          "source_paragraph_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "source_pages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          },
          "reasoning": { "type": "string", "const": "Not separately analyzed in the core extraction task." },
          "financial_impact": { "type": "string", "const": "Not separately analyzed in the core extraction task." },
          "time_horizon": { "type": "string", "const": "Not separately analyzed in the core extraction task." },
          "monitoring_indicators": { "type": "array", "maxItems": 0 },
          "mitigation": { "type": "string", "const": "Not separately analyzed in the core extraction task." },
          "uncertainty": { "type": "string", "const": "Not separately analyzed in the core extraction task." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
