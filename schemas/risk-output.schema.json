{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk-output-v001",
  "title": "Financial Filing Risk Output",
  "description": "Shared normalized output contract for the research repository and the future financial_filing_risk_analyzer product.",
  "type": "object",
  "required": ["case_id", "model_id", "prompt_version", "risks"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "pattern": "^PV[0-9]{3,}$" },
    "risks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/risk" }
    },
    "overall_uncertainty": { "type": "string" },
    "analysis_notes": { "type": "string" }
  },
  "$defs": {
    "risk": {
      "type": "object",
      "required": [
        "risk_id",
        "risk_summary",
        "risk_type",
        "evidence_quote",
        "source_paragraph_ids",
        "source_pages",
        "reasoning",
        "financial_impact",
        "time_horizon",
        "monitoring_indicators",
        "mitigation",
        "uncertainty"
      ],
      "properties": {
        "risk_id": { "type": "string", "pattern": "^R[1-3]$" },
        "risk_summary": { "type": "string", "minLength": 1 },
        "risk_type": {
          "type": "string",
          "enum": [
            "Strategic / Market / Technology",
            "Operational / Supply Chain",
            "Regulatory / Legal / Geopolitical",
            "Financial / Liquidity / Credit",
            "Cybersecurity / Data / Privacy",
            "Other"
          ]
        },
        "evidence_quote": { "type": "string", "minLength": 1 },
        "source_paragraph_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_pages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "reasoning": { "type": "string", "minLength": 1 },
        "financial_impact": { "type": "string", "minLength": 1 },
        "time_horizon": { "type": "string", "minLength": 1 },
        "monitoring_indicators": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mitigation": { "type": "string" },
        "uncertainty": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
