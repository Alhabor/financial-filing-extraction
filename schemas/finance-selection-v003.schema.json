{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance-selection-v003",
  "title": "Finance model core material-risk selection",
  "type": "object",
  "required": ["case_id", "model_id", "prompt_version", "risks"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "pattern": "^PV[0-9]{3,}$" },
    "risks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["risk_id", "risk_summary", "risk_type", "evidence_id"],
        "properties": {
          "risk_id": { "type": "string", "pattern": "^R[1-3]$" },
          "risk_summary": { "type": "string", "minLength": 4, "maxLength": 120 },
          "risk_type": {
            "type": "string",
            "enum": [
              "Strategic / Market / Technology",
              "Operational / Supply Chain",
              "Regulatory / Legal / Geopolitical",
              "Financial / Liquidity / Credit",
              "Cybersecurity / Data / Privacy",
              "Other"
            ]
          },
          "evidence_id": { "type": "string", "pattern": "^E[0-9]{4}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
