{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance-selection-v002",
  "title": "Finance model sentence-evidence selection",
  "type": "object",
  "required": ["case_id", "model_id", "prompt_version", "risks"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "pattern": "^PV[0-9]{3,}$" },
    "risks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "risk_id", "risk_summary", "risk_type", "evidence_id", "reasoning",
          "financial_impact", "time_horizon", "monitoring_indicators", "mitigation", "uncertainty"
        ],
        "properties": {
          "risk_id": { "type": "string", "pattern": "^R[1-3]$" },
          "risk_summary": { "type": "string", "minLength": 1 },
          "risk_type": {
            "type": "string",
            "enum": [
              "Strategic / Market / Technology",
              "Operational / Supply Chain",
              "Regulatory / Legal / Geopolitical",
              "Financial / Liquidity / Credit",
              "Cybersecurity / Data / Privacy",
              "Other"
            ]
          },
          "evidence_id": { "type": "string", "pattern": "^E[0-9]{4}$" },
          "reasoning": { "type": "string", "minLength": 1 },
          "financial_impact": { "type": "string", "minLength": 1 },
          "time_horizon": { "type": "string", "minLength": 1 },
          "monitoring_indicators": { "type": "array", "items": { "type": "string" } },
          "mitigation": { "type": "string", "const": "Not disclosed in the selected evidence sentence." },
          "uncertainty": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
